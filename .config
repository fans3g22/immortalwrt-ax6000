# ImmortalWrt .config for Xiaomi Redmi Router AX6000 (stock layout)
# Target: mediatek/filogic

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=y

# Keep default target images
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=104

# Custom feeds will provide these packages; enable them here.
# If a package name differs in the upstream repo, adjust accordingly.

# nikki (https://github.com/nikkinikki-org/OpenWrt-nikki)
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y

# momo (https://github.com/nikkinikki-org/OpenWrt-momo)
CONFIG_PACKAGE_momo=y
CONFIG_PACKAGE_luci-app-momo=y

# usteer - official OpenWrt WiFi band-steering daemon
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y

# LuCI language packs (optional)
# CONFIG_LUCI_LANG_zh_Hans=y
